# PayPal sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Your server's public URL (ngrok or Render), used for PayPal return links
BASE_URL=http://localhost:3000
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:5500

# Random string used to salt hashes in the flagged registry
REGISTRY_SALT=change-me-to-a-random-string

# Set to true ONLY for local testing without a public webhook URL
SKIP_WEBHOOK_VERIFY=false

# Python risk engine integration (set to your Python executable or venv Python path)
PYTHON_EXECUTABLE=python
