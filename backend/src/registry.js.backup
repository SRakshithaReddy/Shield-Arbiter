// Flagged registry: stores SALTED HASHES of risky identifiers, never raw personal data.
const crypto = require('crypto');
const db = require('./db');

function normalize(type, value) {
  if (!value) return '';
  let v = String(value).trim().toLowerCase();
  if (type === 'email') {
    let [local, domain] = v.split('@');
    if (!domain) return v;
    if (domain === 'gmail.com' || domain === 'googlemail.com') {
      local = local.split('+')[0].replace(/\./g, '');
      domain = 'gmail.com';
    } else {
      local = local.split('+')[0];
    }
    return `${local}@${domain}`;
  }
  if (type === 'address') v = v.replace(/[^a-z0-9]/g, '');
  return v;
}

function hashValue(type, value) {
  const salt = process.env.REGISTRY_SALT || 'dev-salt';
  return crypto.createHash('sha256').update(`${salt}|${type}|${normalize(type, value)}`).digest('hex');
}

function addFlag({ type, value, reason, severity = 50, case_id = null }) {
  const info = db
    .prepare('INSERT INTO flagged_entities (type, hash, reason, severity, case_id) VALUES (?,?,?,?,?)')
    .run(type, hashValue(type, value), reason, severity, case_id);
  return info.lastInsertRowid;
}

function lookup(type, value) {
  if (!value) return [];
  return db
    .prepare("SELECT * FROM flagged_entities WHERE type = ? AND hash = ? AND status = 'ACTIVE'")
    .all(type, hashValue(type, value));
}

// Exact-match check on all identifiers of an order. Rakshitha's engine can add fuzzy/linked matching on top.
function findMatches(order) {
  const checks = [
    ['email', order.email],
    ['payer_id', order.payer_id],
    ['device', order.device_id],
    ['ip', order.ip],
    ['address', order.shipping_address],
  ];
  const matches = [];
  for (const [type, value] of checks) {
    for (const row of lookup(type, value)) {
      matches.push({
        type,
        match: 'exact',
        flag_id: row.id,
        reason: row.reason,
        severity: row.severity,
        case_id: row.case_id,
        flagged_on: row.created_at,
      });
    }
  }
  return matches;
}

function clearFlag(id) {
  return db.prepare("UPDATE flagged_entities SET status = 'CLEARED' WHERE id = ?").run(id).changes > 0;
}

function listFlags() {
  return db.prepare('SELECT id, type, reason, severity, case_id, status, created_at FROM flagged_entities ORDER BY id DESC').all();
}

module.exports = { addFlag, lookup, findMatches, clearFlag, listFlags, hashValue, normalize };
