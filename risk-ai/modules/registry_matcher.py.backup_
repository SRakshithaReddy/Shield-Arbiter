
import pandas as pd
from rapidfuzz import fuzz

from modules.data_normalizer import (
    normalize_email,
    normalize_ip,
    normalize_device_id
)


def normalize_identifier(identifier_type, value):
    """Normalise an identifier according to its type."""

    if identifier_type == "email":
        return normalize_email(value)

    if identifier_type == "ip_address":
        return normalize_ip(value)

    if identifier_type == "device_id":
        return normalize_device_id(value)

    return None


def match_registry(transaction, registry_path="data/flagged_registry.csv"):
    """Find exact and possible fuzzy matches in the active registry."""

    registry = pd.read_csv(registry_path).fillna("")
    matches = []

    transaction_fields = {
        "email": transaction.get("email"),
        "device_id": transaction.get("device_id"),
        "ip_address": transaction.get("ip_address")
    }

    for identifier_type, raw_value in transaction_fields.items():

        transaction_value = normalize_identifier(
            identifier_type, raw_value
        )

        if not transaction_value:
            continue

        for _, record in registry.iterrows():

            if record["status"].upper() != "ACTIVE":
                continue

            if record["identifier_type"] != identifier_type:
                continue

            registry_value = normalize_identifier(
                identifier_type,
                record["identifier_value"]
            )

            if not registry_value:
                continue

            # Exact match
            if transaction_value == registry_value:
                matches.append({
                    "registry_id": record["registry_id"],
                    "identifier_type": identifier_type,
                    "match_type": "EXACT",
                    "matched_value": transaction_value,
                    "reason": record["reason"],
                    "severity": record["severity"]
                })

            # Fuzzy matching only for emails with the same domain
            elif identifier_type == "email":

                transaction_local, transaction_domain = transaction_value.rsplit("@", 1)
                registry_local, registry_domain = registry_value.rsplit("@", 1)

                if transaction_domain == registry_domain:

                    similarity = fuzz.ratio(
                        transaction_local,
                        registry_local
                    )

                    if similarity >= 90:
                        matches.append({
                            "registry_id": record["registry_id"],
                            "identifier_type": identifier_type,
                            "match_type": "POSSIBLE_FUZZY",
                            "matched_value": registry_value,
                            "similarity": similarity,
                            "reason": record["reason"],
                            "severity": record["severity"]
                        })

    return matches
